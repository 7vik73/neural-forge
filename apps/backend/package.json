{
  "name": "@forge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@forge/connectors": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@forge/workflow": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/client": "6.19.3",
    "bullmq": "6.4.0",
    "cookie-parser": "1.4.7",
    "cron-parser": "5.4.0",
    "csv-parse": "6.1.0",
    "csv-stringify": "6.6.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "googleapis": "166.0.0",
    "imapflow": "1.0.195",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.2.0",
    "mailparser": "3.7.5",
    "mysql2": "3.15.3",
    "nodemailer": "7.0.11",
    "pg": "8.16.3",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/mailparser": "3.4.6",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6"
  }
}
