{
  "name": "neural-forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:integration": "pnpm build:packages && pnpm --filter @forge/backend build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "dev": "pnpm build:packages && concurrently -k -n api,worker,web 'pnpm --filter @forge/backend dev' 'pnpm --filter @forge/backend dev:worker' 'pnpm --filter @forge/web dev'",
    "build:packages": "pnpm --filter './packages/**' build",
    "setup": "node scripts/manage.mjs setup",
    "start": "node scripts/manage.mjs start",
    "stop": "node scripts/manage.mjs stop",
    "status": "node scripts/manage.mjs status",
    "diagnostics": "node scripts/manage.mjs diagnostics",
    "db:migrate": "pnpm --filter @forge/backend db:migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@forge/contracts": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "concurrently": "9.2.1",
    "dotenv": "17.2.3",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "@forge/connectors": "workspace:*",
    "@forge/workflow": "workspace:*"
  }
}
